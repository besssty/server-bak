# ── Сервер ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Фронтенд клієнт ───────────────────────────────────────────
# URL фронтенду — використовується у CORS та OAuth редіректах
CLIENT_URL=http://localhost:5173

# ── База даних PostgreSQL через Prisma ────────────────────────
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flashlearn

# ── Redis ─────────────────────────────────────────────────────
# Використовується для кешування, обмеження частоти запитів 
REDIS_URL=redis://localhost:6379
# Базові обмеження фонової генерації карток через BullMQ
CARD_GENERATION_CONCURRENCY=1
CARD_GENERATION_RATE_LIMIT_MAX=3
CARD_GENERATION_RATE_LIMIT_DURATION_MS=60000
CARD_GENERATION_QUEUE_LIMIT=30

# ── JWT ───────────────────────────────────────────────────────
# ОБОВ'ЯЗКОВО: мінімум 32 символи, генерація:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_secure_random_string_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_generate_another_secure_random_string_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth 2.0 ──────────────────────────────────────────
# Отримати на: https://console.cloud.google.com/apis/credentials
# Дозволений redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Якщо не вказано — використовується ${SERVER_URL}/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ── OpenAI ────────────────────────────────────────────────────
# Отримати на: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
# Модель для генерації карток (рекомендується gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
