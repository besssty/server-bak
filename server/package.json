{
	"name": "flashlearn-server",
	"version": "2.0.0",
	"description": "FlashLearn backend — Express + Prisma + Redis + BullMQ",
	"main": "dist/index.js",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "ts-node-dev --respawn --transpile-only src/index.ts",
		"build": "prisma generate && tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:sm2-table": "vitest run test/sm2AlgorithmTable.test.ts --reporter=verbose --silent=false",
		"test:retention-table": "vitest run test/retentionRateTable.test.ts --reporter=verbose --silent=false",
		"test:watch": "vitest",
		"start": "node dist/index.js",
		"start:prod": "prisma migrate deploy && node dist/index.js",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:deploy": "prisma migrate deploy",
		"prisma:studio": "prisma studio"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"bullmq": "^5.76.4",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"google-auth-library": "^10.6.2",
		"helmet": "^8.1.0",
		"ioredis": "^5.10.1",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.10.1",
		"multer": "^2.1.1",
		"openai": "^6.35.0",
		"pdf-parse": "^2.4.5",
		"prisma": "^7.8.0",
		"zod": "^4.4.1"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/multer": "^2.1.0",
		"@types/node": "^25.6.0",
		"ts-node-dev": "^2.0.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	}
}
